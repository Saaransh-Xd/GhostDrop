# Object storage. Keep STORAGE_BACKEND=local to use the local uploads directory.
# For AWS S3, leave S3_ENDPOINT_URL empty. For Cloudflare R2, set it to the
# account endpoint, e.g. https://<account-id>.r2.cloudflarestorage.com.
